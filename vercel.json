{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/p",        "destination": "/public/p/index.html" },
    { "source": "/p/",       "destination": "/public/p/index.html" },
    { "source": "/p/:slug",  "destination": "/public/p/:slug/index.html" },
    { "source": "/googled087903ec22ea1b9.html", "destination": "/public/googled087903ec22ea1b9.html" },
    { "source": "/BingSiteAuth.xml", "destination": "/public/BingSiteAuth.xml" },
    { "source": "/(.*)",     "destination": "/public/$1" }
  ],
  "functions": {
    "api/report.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
